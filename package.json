{
  "name": "@shlinkio/shlink-frontend-kit",
  "description": "React components and utilities for Shlink frontend projects",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shlinkio/shlink-frontend-kit.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tailwind.preset.css": {
      "style": "./dist/tailwind.preset.css",
      "default": "./dist/tailwind.preset.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && cp ./src/tailwind.preset.css ./dist/tailwind.preset.css",
    "test": "vitest run",
    "test:ci": "node --run test -- --coverage",
    "cs": "node --run lint && node --run format:check",
    "cs:fix": "node --run lint:fix && node --run format",
    "lint": "oxlint src test .storybook",
    "lint:fix": "node --run lint -- --fix",
    "format": "oxfmt src test .storybook",
    "format:check": "node --run format -- --check",
    "types": "tsc",
    "storybook": "storybook dev -p 3001",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@vitest/browser-playwright": "^4.1.10",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "@fortawesome/fontawesome-common-types": "^7.0.0",
    "@fortawesome/fontawesome-free": "^7.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-regular-svg-icons": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^3.0.0",
    "react": "^19.1",
    "react-dom": "^19.1",
    "react-router": "^8.0.1 || ^7.0.2",
    "tailwindcss": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shlinkio/eslint-config-js-coding-standard": "~4.0.0",
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/react-vite": "^10.5.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@total-typescript/shoehorn": "^0.1.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.2",
    "axe-core": "^4.12.1",
    "history": "^5.3.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.0",
    "storybook": "^10.3.6",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.0.3"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
